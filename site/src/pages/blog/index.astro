---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';
import { getCollection } from 'astro:content';

const title = 'Blog';
const description =
  'Field notes from the Hunt Games network: how entries get catalogued, genre explainers, and cross-network recommendations.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE.name} Blog`,
    url: new URL('/blog/', SITE.url).href,
    description,
  },
];

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={description} schema={schema}>
  <div class="wrap">
    <p class="eyebrow">Blog</p>
    <h1>Field notes</h1>
    <p class="lede">
      Notes that span the network rather than any one wiki &mdash; how an entry gets catalogued,
      genre explainers, and recommendations that cross between worlds.
    </p>
  </div>

  <div class="wrap">
    <ul class="posts">
      {
        posts.map((post) => (
          <li class="post">
            <a class="post-link" href={`/blog/${post.id}/`}>
              <span class="post-date">
                <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
              </span>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <p class="post-tags">{post.data.tags.join(' · ')}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    {posts.length === 0 && <p class="muted">No posts yet.</p>}
  </div>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .post {
    border-bottom: 1px solid var(--line);
  }
  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem 0;
  }
  .post-link:hover .post-title {
    color: var(--accent);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .post-title {
    font-size: 1.4rem;
    margin: 0.4rem 0 0.5rem;
  }
  .post-desc {
    color: var(--text-soft);
    max-width: var(--measure);
    margin: 0;
  }
  .post-tags {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
    margin: 0.7rem 0 0;
  }
</style>
